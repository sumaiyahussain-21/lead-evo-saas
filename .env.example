# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB Atlas connection string for persistent cloud data
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/leadevo?retryWrites=true&w=majority
MONGODB_URI=""

# JWT_SECRET: Secret key for signing secure auth tokens
JWT_SECRET="lead-evo-secret-jwt-key-2026"